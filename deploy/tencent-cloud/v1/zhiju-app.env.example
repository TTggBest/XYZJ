# Install as root:zhiju 0640 at /etc/zhiju/zhiju-app.env after replacing CHANGE_ME.
ZHJ_ENV=production
ZHJ_DEPLOYMENT=cloud
ZHJ_DATABASE_URL=mysql+pymysql://zhiju_app:CHANGE_ME@127.0.0.1:3306/zhiju_cloud?charset=utf8mb4
ZHJ_HOST=127.0.0.1
ZHJ_PORT=19732
ZHJ_LOG_LEVEL=INFO
ZHJ_DEVICE_ROLE=worker
ZHJ_SHARED_ROOT=/var/lib/zhiju/shared
ZHJ_ARTIFACT_ROOT=/var/lib/zhiju/shared/artifacts
ZHJ_REALTIME_HUB_URL=
# Create a Google OAuth 2.0 client of type "Web application" for the cloud site.
ZHJ_YOUTUBE_OAUTH_CLIENT_ID=CHANGE_ME
ZHJ_YOUTUBE_OAUTH_CLIENT_SECRET=CHANGE_ME
ZHJ_YOUTUBE_OAUTH_REDIRECT_URI=https://xyzj.chronaraxy.com/api/v3/youtube/oauth/callback
# Generate once with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
ZHJ_OAUTH_ENCRYPTION_KEY=CHANGE_ME
