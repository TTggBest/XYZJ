# Install as root:zhiju 0640 at /etc/zhiju/zhiju-app.env after replacing CHANGE_ME.
ZHJ_ENV=production
ZHJ_DEPLOYMENT=cloud
ZHJ_DATABASE_URL=mysql+pymysql://zhiju_app:CHANGE_ME@127.0.0.1:3306/zhiju_cloud?charset=utf8mb4
ZHJ_HOST=127.0.0.1
ZHJ_PORT=19732
ZHJ_LOG_LEVEL=INFO
ZHJ_DEVICE_ROLE=worker
ZHJ_SHARED_ROOT=/var/lib/zhiju/shared
ZHJ_ARTIFACT_ROOT=/var/lib/zhiju/shared/artifacts
ZHJ_REALTIME_HUB_URL=
